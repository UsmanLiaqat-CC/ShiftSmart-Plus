<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent"
  >
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leftguidline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="20dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topguidline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="20dp" />

    <RelativeLayout
        android:id="@+id/header_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        app:layout_constraintEnd_toEndOf="@id/rightguidline"
        app:layout_constraintStart_toStartOf="@id/leftguidline"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_arrow"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="center_vertical"
            android:backgroundTint="@android:color/transparent"
            android:contentDescription="email icon"
            android:src="@drawable/ic_arrow_back"
            app:tint="#898989" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/list_of_errors"
            android:textSize="@dimen/_16sdp" />
    </RelativeLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/errors_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/leftguidline"
        app:layout_constraintEnd_toEndOf="@id/rightguidline"
        app:layout_constraintTop_toBottomOf="@id/header_ll"
        android:layout_marginTop="@dimen/_5sdp"
        app:cornerRadius="@dimen/_4sdp"
        android:text="@string/app_operation_error"
        android:backgroundTint="@color/orange"
        android:padding="@dimen/_12sdp"
        />

    <TextView
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/app_operation_issues"
        app:layout_constraintStart_toStartOf="@id/leftguidline"
        app:layout_constraintTop_toBottomOf="@id/errors_btn"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_5sdp"
        android:textSize="@dimen/_16sdp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/errors_recyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv1"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/_5sdp"
        tools:listitem="@layout/item_app_issue"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/rightguidline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="20dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomguidline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
