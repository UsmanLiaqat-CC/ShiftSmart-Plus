<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.fragments.attendace.AttendanceFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leftguidline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="20dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topguidline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="20dp" />
    <RelativeLayout
        android:id="@+id/header_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_10sdp"
        android:fitsSystemWindows="true"
        app:layout_constraintEnd_toEndOf="@id/rightguidline"
        app:layout_constraintStart_toStartOf="@id/leftguidline"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_arrow"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="center_vertical"
            android:backgroundTint="@android:color/transparent"
            android:contentDescription="email icon"
            android:src="@drawable/ic_arrow_back"
            app:tint="#898989" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignTop="@id/back_arrow"
            android:layout_alignBottom="@id/back_arrow"
            android:gravity="center"
            android:text="@string/attendance"
            android:textSize="@dimen/_16sdp" />
    </RelativeLayout>



    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/bottomguidline"
        app:layout_constraintEnd_toStartOf="@+id/rightguidline"
        app:layout_constraintStart_toStartOf="@id/leftguidline"
        app:layout_constraintTop_toBottomOf="@id/header_ll">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_4sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="@dimen/_3sdp"
            app:strokeColor="@color/white">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50sdp"
                android:orientation="horizontal"
                android:padding="@dimen/_5sdp">
                <TextView
                    android:id="@+id/start_tv"
                    android:layout_width="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/start_iv"
                    android:layout_height="match_parent"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:hint="@string/select_date"

                    android:paddingStart="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_10sdp"

                    />
                <ImageView
                    android:id="@+id/start_iv"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="email icon"
                    android:src="@drawable/baseline_calendar_month_24"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="@dimen/_5sdp"
                    app:tint="#898989" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/done_btn"
            android:layout_width="wrap_content"
            android:layout_margin="@dimen/_5sdp"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            android:text="@string/done"
            android:backgroundTint="@color/primary_color"
            android:textColor="@color/white"
            android:layout_marginEnd="@dimen/_5sdp"
            />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Header Row with Horizontal Scroll -->
            <HorizontalScrollView
                android:id="@+id/header_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/header_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/_8sdp"
                    android:background="@color/primary_color">

                    <!-- No. Header -->
                    <TextView
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="wrap_content"
                        android:text="No."
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11sdp"
                        android:gravity="center"
                        android:singleLine="true"/>

                    <!-- Status Header -->
                    <TextView
                        android:layout_width="@dimen/_70sdp"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_4sdp"
                        android:paddingEnd="@dimen/_4sdp"
                        android:singleLine="true"/>

                    <!-- Type Header -->
                    <TextView
                        android:layout_width="@dimen/_70sdp"
                        android:layout_height="wrap_content"
                        android:text="Type"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_4sdp"
                        android:paddingEnd="@dimen/_4sdp"
                        android:singleLine="true"/>

                    <!-- Date Header -->
                    <TextView
                        android:layout_width="@dimen/_140sdp"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_4sdp"
                        android:paddingEnd="@dimen/_4sdp"
                        android:singleLine="true"/>

                    <!-- In Store Header -->
                    <TextView
                        android:layout_width="@dimen/_60sdp"
                        android:layout_height="wrap_content"
                        android:text="In Store"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_4sdp"
                        android:paddingEnd="@dimen/_4sdp"
                        android:singleLine="true"/>

                    <!-- Local Time Header -->
                    <TextView
                        android:layout_width="@dimen/_70sdp"
                        android:layout_height="wrap_content"
                        android:text="Local Time"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_4sdp"
                        android:paddingEnd="@dimen/_4sdp"
                        android:singleLine="true"/>

                </LinearLayout>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/recycler_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/header_scroll"
                android:scrollbars="none">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/records_rv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"/>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/no_record_found"
                android:layout_width="wrap_content"
                android:layout_centerInParent="true"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:hint="@string/no_record_found"/>
        </RelativeLayout>



    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/leftguidline"
        app:layout_constraintEnd_toEndOf="@id/rightguidline"
        app:layout_constraintTop_toBottomOf="@id/header_ll"
        app:layout_constraintBottom_toBottomOf="@id/bottomguidline"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/rightguidline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="20dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomguidline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="20dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
