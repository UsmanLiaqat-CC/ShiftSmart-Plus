<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ShiftSmartPlus" parent="Theme.Material3.Light.NoActionBar">

        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:windowLightStatusBar">true</item> <!-- Enables dark icons -->

    </style>
    <style name="TransparentDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="Theme.ShiftSmartPlus" parent="Base.Theme.ShiftSmartPlus" />
</resources>